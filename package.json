{
  "name": "elite-courts-web",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs",
    "admin:bootstrap:production": "tsx scripts/bootstrap-production-admin.ts",
    "db:rebuild": "node scripts/rebuild-database.mjs",
    "db:content-seeds:generate": "tsx scripts/generate-content-seeds.ts",
    "db:menu:generate": "tsx scripts/generate-menu-seed.ts",
    "pdf:tournament-preview": "node --conditions=react-server node_modules/tsx/dist/cli.mjs scripts/generate-tournament-results-preview.ts",
    "receipts:migrate": "node scripts/migrate-private-receipts.mjs",
    "images:verify": "node scripts/verify-optimized-images.mjs --require-originals-removed",
    "verify:offline": "npm run lint && npm run typecheck && npm run test && npm run images:verify && node scripts/offline-next.mjs build",
    "db:install": "node scripts/install-database.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/pdfkit": "^0.17.6",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.42.0",
    "motion": "^13.2.0",
    "next": "^16.3.4",
    "nodemailer": "^10.0.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "ignore": "5.3.2",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
